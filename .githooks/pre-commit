#!/bin/sh
# Blocks commits that contain credentials. Enable once per clone:
#   git config core.hooksPath .githooks
patterns='AIza[0-9A-Za-z_-]{30,}|GOCSPX-[0-9A-Za-z_-]+|ya29\.[0-9A-Za-z_-]{20,}|1//0[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY|ghp_[0-9A-Za-z]{30,}|github_pat_[0-9A-Za-z_]{30,}|xox[abprs]-[0-9A-Za-z-]+|"client_secret"[[:space:]]*:|"refresh_token"[[:space:]]*:'

# --no-renames: a file renamed and edited is still a new file to scan.
files=$(git diff --cached --name-only --no-renames --diff-filter=ACM)
[ -z "$files" ] && exit 0

bad_names=$(printf '%s\n' "$files" | grep -iE '(^|/)(\.env(\.[^/]*)?|client_secret[^/]*\.json|[^/]*credentials[^/]*\.json|key\.properties|local\.properties)$|\.(pem|p12|jks|keystore)$')
if [ -n "$bad_names" ]; then
  echo "pre-commit: refusing to commit credential files:" >&2
  printf '%s\n' "$bad_names" | sed 's/^/  /' >&2
  exit 1
fi

# Local-only modules (lib/private, test/private) never enter the repository,
# and public files must not reference the tool they use.
local_only=$(git diff --cached --name-only --no-renames --diff-filter=ACM | grep -iE '^(lib|test)/private/|yt[-_]?dlp')
if [ -n "$local_only" ]; then
  echo "pre-commit: refusing to commit local-only paths:" >&2
  printf '%s\n' "$local_only" | sed 's/^/  /' >&2
  exit 1
fi
local_refs=$(printf '%s\n' "$files" | while IFS= read -r f; do
  git show ":$f" 2>/dev/null | grep -nIiE 'yt[-_]?dlp' | sed "s|^|$f:|"
done)
if [ -n "$local_refs" ]; then
  echo "pre-commit: public files reference a local-only tool:" >&2
  printf '%s\n' "$local_refs" | cut -c1-120 >&2
  exit 1
fi

hits=$(printf '%s\n' "$files" | while IFS= read -r f; do
  git show ":$f" 2>/dev/null | grep -nIE "$patterns" | sed "s|^|$f:|"
done)
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret found (commit blocked):" >&2
  printf '%s\n' "$hits" | cut -c1-120 >&2
  exit 1
fi
exit 0
